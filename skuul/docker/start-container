#!/usr/bin/env bash
set -e

mkdir -p /var/www/html/bootstrap/cache
mkdir -p /var/www/html/storage/framework/cache/data
mkdir -p /var/www/html/storage/framework/sessions
mkdir -p /var/www/html/storage/framework/views
mkdir -p /var/www/html/storage/framework/testing
mkdir -p /var/www/html/storage/logs
mkdir -p /var/www/html/vendor
mkdir -p /var/www/html/node_modules

chown -R sail:sail /var/www/html/storage
chown -R sail:sail /var/www/html/bootstrap/cache
chown -R sail:sail /var/www/html/vendor
chown -R sail:sail /var/www/html/node_modules

if [ -n "$DB_HOST" ] && [ -n "$DB_DATABASE" ]; then
    max_attempts="${MIGRATION_MAX_ATTEMPTS:-10}"
    retry_delay="${MIGRATION_RETRY_DELAY:-3}"
    attempts=0

    until php artisan migrate --force; do
        attempts=$((attempts + 1))

        if [ "$attempts" -ge "$max_attempts" ]; then
            echo "Database migrations failed after $attempts attempts." >&2
            exit 1
        fi

        echo "Database not ready; retrying migration in ${retry_delay}s (${attempts}/${max_attempts})." >&2
        sleep "$retry_delay"
    done
fi

exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
